---
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '../styles/global.css';

// 预加载各页共用的核心字体子集，避免刷新时的字体切换闪烁
import fontRegular111 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-111.woff2?url';
import fontRegular112 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-112.woff2?url';
import fontRegular113 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-113.woff2?url';
import fontRegular114 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-114.woff2?url';
import fontRegular115 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-115.woff2?url';
import fontRegular116 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-116.woff2?url';
import fontRegular117 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-117.woff2?url';
import fontRegular118 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-118.woff2?url';
import fontRegular119 from 'lxgw-wenkai-webfont/files/lxgwwenkai-regular-subset-119.woff2?url';
import fontBold112 from 'lxgw-wenkai-webfont/files/lxgwwenkai-bold-subset-112.woff2?url';
import fontBold116 from 'lxgw-wenkai-webfont/files/lxgwwenkai-bold-subset-116.woff2?url';
import fontBold117 from 'lxgw-wenkai-webfont/files/lxgwwenkai-bold-subset-117.woff2?url';
import fontBold119 from 'lxgw-wenkai-webfont/files/lxgwwenkai-bold-subset-119.woff2?url';

const preloadedFonts = [
  fontRegular111, fontRegular112, fontRegular113, fontRegular114, fontRegular115,
  fontRegular116, fontRegular117, fontRegular118, fontRegular119,
  fontBold112, fontBold116, fontBold117, fontBold119
];
import SiteHeader from '../components/SiteHeader.astro';
import BackToTop from '../components/BackToTop.astro';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = siteConfig.description
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url);
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={siteConfig.author.name} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15130f" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {preloadedFonts.map(href => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      description: siteConfig.description,
      url: siteConfig.url,
      inLanguage: siteConfig.locale,
      author: {
        '@type': 'Person',
        name: siteConfig.author.name,
        email: siteConfig.author.email
      }
    })} />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <BackToTop />
    <script is:inline>
      (() => {
        const linkSelector = ".weekly-entry, .editorial-entry-content, .entry-link, .search-result a";
        const cardSelector = ".weekly-entry, .editorial-entry, .entry, .search-result";
        const storageKey = "blog:last-navigated-card";
        let suppressedCard = document.querySelector("[data-return-suppressed]");

        const suppressCard = (card) => {
          if (!card) return;
          card.setAttribute("data-return-suppressed", "");
          suppressedCard = card;
        };
        const cardForLink = (link) => link.closest(cardSelector) || link;
        const restoreSuppressedCard = () => {
          try {
            const saved = JSON.parse(sessionStorage.getItem(storageKey) || "null");
            if (saved?.from !== location.href) return;
            sessionStorage.removeItem(storageKey);
            const link = Array.from(document.querySelectorAll(linkSelector))
              .find((item) => item.href === saved.href);
            suppressCard(link && cardForLink(link));
          } catch {}
        };
        const releaseSuppressionIfOutside = (target) => {
          if (!suppressedCard || (target instanceof Node && suppressedCard.contains(target))) return;
          suppressedCard.removeAttribute("data-return-suppressed");
          suppressedCard = null;
        };

        restoreSuppressedCard();

        document.addEventListener("pointermove", (event) => {
          releaseSuppressionIfOutside(event.target);
        }, { passive: true });
        document.addEventListener("pointerdown", (event) => {
          releaseSuppressionIfOutside(event.target);
        }, { passive: true });
        document.addEventListener("focusin", (event) => {
          if (!suppressedCard || !(event.target instanceof Element) || !event.target.matches(":focus-visible")) return;
          suppressedCard.removeAttribute("data-return-suppressed");
          suppressedCard = null;
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (
            !(target instanceof Element) ||
            event.button !== 0 ||
            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
          ) return;

          const link = target.closest(linkSelector);
          const targetName = link?.getAttribute("target");
          if (!link || (targetName && targetName.toLowerCase() !== "_self")) return;

          suppressCard(cardForLink(link));
          try {
            sessionStorage.setItem(storageKey, JSON.stringify({ from: location.href, href: link.href }));
          } catch {}
        }, true);

        window.addEventListener("pagehide", () => {
          if (suppressedCard?.contains(document.activeElement)) {
            document.activeElement.blur?.();
          }
        });
      })();
    </script>
  </body>
</html>