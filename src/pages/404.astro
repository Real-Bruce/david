---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
---

<BaseLayout title="页面不存在" description="这个页面不存在。">
  <main class="article">
    <h1>404</h1>
    <div class="prose">
      <p>这个页面不存在，可能已经被移动或删除。</p>
      <p><a href={withBase('/')}>返回首页</a></p>
    </div>
  </main>
</BaseLayout>
