---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
---

<BaseLayout title="关于" description={`关于 ${siteConfig.author.name} 和这个博客。`}>
  <main class="article">
    <h1>关于</h1>
    <div class="prose">
      <p>这是一个用 Markdown 写作、用 Astro 构建、托管在静态平台上的个人博客。</p>

      <h2>内容结构</h2>
      <ul>
        <li><strong>周刊</strong>：每周整理一次发现的有趣网站、工具和文章。</li>
        <li><strong>博客</strong>：完整的长文，适合沉淀方案、复盘和思考。</li>
        <li><strong>随笔</strong>：碎片化记录，不追求完整结构。</li>
      </ul>

      <h2>联系与订阅</h2>
      <ul class="contact-list">
        <li>
          <span class="contact-label">Email</span>
          <a href={siteConfig.social.email}>{siteConfig.author.email}</a>
        </li>
        <li>
          <span class="contact-label">GitHub</span>
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub 主页</a>
        </li>
        <li>
          <span class="contact-label">RSS</span>
          <a href="/rss.xml">订阅本站更新</a>
        </li>
      </ul>
    </div>
  </main>
</BaseLayout>
