---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EditorialPostList from '../../components/EditorialPostList.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/base';

const posts = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="随笔" description="随时记录的碎片想法与短篇随笔。">
  <main class="container editorial-page">
    <header class="page-head">
      <div class="section-head">
        <span class="page-head-icon tint-notes"><Icon name="notes" size={38} /></span>
        <div class="section-head-text">
          <div class="weekly-heading">
            <span class="weekly-count">{posts.length} 条记录</span>
          </div>
          <p class="page-head-desc">记录当下的心情、地点和一闪而过的念头。</p>
        </div>
      </div>
    </header>

    <EditorialPostList
      kind="notes"
      posts={posts.map(post => ({
        href: withBase(`/notes/${post.id}/`),
        title: post.data.title,
        description: post.data.description,
        date: post.data.pubDate,
        tags: post.data.tags,
        mood: post.data.mood,
        location: post.data.location
      }))}
    />
  </main>
</BaseLayout>
