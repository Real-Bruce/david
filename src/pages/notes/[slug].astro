---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/base';
import ArticleNavigation from '../../components/ArticleNavigation.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, previous: posts[index - 1], next: posts[index + 1] } }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="article article-notes">
    <header class="article-header article-header-notes">
      <div class="meta">
        <span class="kind-icon tint-notes"><Icon name="notes" size={18} /><span class="sr-only">随笔</span></span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1>{post.data.title}</h1>

      {post.data.location && (
        <div class="article-context" aria-label="随笔地点">
          <span class="article-context-item article-context-location">
            <Icon name="location" size={16} />
            <span>{post.data.location}</span>
          </span>
        </div>
      )}

      {post.data.tags.length > 0 && (
        <div class="article-meta" aria-label="文章标签">
          {post.data.tags.map(tag => <a class="tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
    <ArticleNavigation
      previous={previous && { href: withBase(`/notes/${previous.id}/`), title: previous.data.title }}
      next={next && { href: withBase(`/notes/${next.id}/`), title: next.data.title }}
    />
  </main>
</BaseLayout>
