---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const charCount = post.body ? post.body.replace(/\s/g, '').length : 0;
const readingTime = Math.max(1, Math.ceil(charCount / 400));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ReadingProgress />
  <main class="article-layout">
    <TOC headings={headings} />

    <div class="article-main">
      <div class="meta">
        <span class="kind kind-blog">博客</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span class="reading-time">约 {readingTime} 分钟</span>
      </div>

      <h1>{post.data.title}</h1>

      <div class="article-meta">
        {post.data.tags.map(tag => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
      </div>

      <div class="prose">
        <Content />
      </div>
    </div>
  </main>
</BaseLayout>