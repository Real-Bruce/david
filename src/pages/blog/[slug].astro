---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TOC from '../../components/TOC.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/base';
import ArticleNavigation from '../../components/ArticleNavigation.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, previous: posts[index - 1], next: posts[index + 1] } }));
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);

const charCount = post.body ? post.body.replace(/\s/g, '').length : 0;
const readingTime = Math.max(1, Math.ceil(charCount / 400));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ReadingProgress />
  <main class="article-layout">
    <TOC headings={headings} />

    <div class="article-main">
      <header class="article-header article-header-blog">
        <div class="meta">
          <span class="kind-icon tint-blog"><Icon name="blog" size={18} /><span class="sr-only">博客</span></span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="reading-time">约 {readingTime} 分钟</span>
        </div>

        <h1>{post.data.title}</h1>

        {post.data.tags.length > 0 && (
          <div class="article-meta" aria-label="文章标签">
            {post.data.tags.map(tag => <a class="tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
          </div>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>
      <ArticleNavigation
        previous={previous && { href: withBase(`/blog/${previous.id}/`), title: previous.data.title }}
        next={next && { href: withBase(`/blog/${next.id}/`), title: next.data.title }}
      />
    </div>
  </main>
</BaseLayout>
