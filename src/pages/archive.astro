---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialPostList from '../components/EditorialPostList.astro';
import ArchiveSearch from '../components/ArchiveSearch.astro';
import { getPublishedPosts, getPostHref, getPostKind, type AnyPost } from '../lib/posts';
import { getWeeklyDigest } from '../lib/weekly';
import Icon from "../components/Icon.astro";

const posts = await getPublishedPosts();

const groupedPosts = posts.reduce((acc, post) => {
  // 统一用 UTC 取值：条目日期由 EditorialPostList 经 toISOString() 以 UTC 显示，
  // 若这里用构建机本地时区，在 UTC 负时区上会把月初文章分到上个月甚至上一年。
  const year = String(post.data.pubDate.getUTCFullYear());
  const month = String(post.data.pubDate.getUTCMonth() + 1).padStart(2, '0');

  if (!acc.has(year)) acc.set(year, new Map<string, AnyPost[]>());
  const yearMap = acc.get(year)!;
  if (!yearMap.has(month)) yearMap.set(month, []);
  yearMap.get(month)!.push(post);

  return acc;
}, new Map<string, Map<string, AnyPost[]>>());

const archiveYears = [...groupedPosts.keys()]
  .sort((a, b) => Number(b) - Number(a))
  .map(year => ({
    year,
    months: [...groupedPosts.get(year)!.keys()]
      .sort((a, b) => Number(b) - Number(a))
      .map(month => ({ month, posts: groupedPosts.get(year)!.get(month)! }))
  }));
const years = archiveYears.map(({ year }) => year);
---

<BaseLayout title="归档" description="按时间浏览全部博客、周刊和随笔，也可以直接搜索。">
  <main class="container editorial-page archive-page">
    <header class="page-head">
      <div class="weekly-heading">
        <span id="archive-result-count" class="weekly-count" aria-live="polite">已归档 {posts.length} 篇</span>
      </div>
      <nav id="archive-filter-controls" class="archive-filters" aria-label="归档筛选">
        <div class="archive-type-filters" role="group" aria-label="内容类型">
          <button type="button" data-filter-kind="all" data-tooltip="All" aria-label="All" title="All" aria-pressed="true"><Icon name="archive" size={16} /></button>
          <button type="button" data-filter-kind="weekly" data-tooltip="Weekly" aria-label="Weekly" title="Weekly"><Icon name="weekly" size={16} /></button>
          <button type="button" data-filter-kind="blog" data-tooltip="Blog" aria-label="Blog" title="Blog"><Icon name="blog" size={16} /></button>
          <button type="button" data-filter-kind="notes" data-tooltip="Notes" aria-label="Notes" title="Notes"><Icon name="notes" size={16} /></button>
        </div>
        <div class="archive-year-links" aria-label="年份跳转">{years.map(year => <a href={`#archive-year-${year}`}>{year}</a>)}</div>
      </nav>
    </header>

    <section class="section archive-search-section">
      <ArchiveSearch />
    </section>

    <div id="archive-list" class="archive-groups">
      {archiveYears.map(({ year, months }) => (
        <section class="archive-year" id={`archive-year-${year}`} data-year={year}>
          <header class="archive-year-heading">
            <h2>{year}</h2>
          </header>

          {months.map(({ month, posts: monthPosts }) => (
            <section class="archive-month">
              <h3 class="archive-month-title">{month} 月</h3>
              <EditorialPostList
                kind="archive"
                posts={monthPosts.map(post => ({
                  href: getPostHref(post),
                  title: getPostKind(post) === 'weekly' ? getWeeklyDigest(post as Extract<AnyPost, { collection: 'weekly' }>).title : post.data.title,
                  description: post.data.description,
                  date: post.data.pubDate,
                  tags: post.data.tags,
                  postKind: getPostKind(post),
                  issue: getPostKind(post) === 'weekly' ? (post as Extract<AnyPost, { collection: 'weekly' }>).data.issue : undefined
                }))}
              />
            </section>
          ))}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
