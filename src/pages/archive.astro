---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialPostList from '../components/EditorialPostList.astro';
import ArchiveSearch from '../components/ArchiveSearch.astro';
import { getPublishedPosts, getPostHref, getPostKind, type AnyPost } from '../lib/posts';

const posts = await getPublishedPosts();

const groupedPosts = posts.reduce((acc, post) => {
  // 统一用 UTC 取值：条目日期由 EditorialPostList 经 toISOString() 以 UTC 显示，
  // 若这里用构建机本地时区，在 UTC 负时区上会把月初文章分到上个月甚至上一年。
  const year = String(post.data.pubDate.getUTCFullYear());
  const month = String(post.data.pubDate.getUTCMonth() + 1).padStart(2, '0');

  if (!acc.has(year)) acc.set(year, new Map<string, AnyPost[]>());
  const yearMap = acc.get(year)!;
  if (!yearMap.has(month)) yearMap.set(month, []);
  yearMap.get(month)!.push(post);

  return acc;
}, new Map<string, Map<string, AnyPost[]>>());

const archiveYears = [...groupedPosts.keys()]
  .sort((a, b) => Number(b) - Number(a))
  .map(year => ({
    year,
    months: [...groupedPosts.get(year)!.keys()]
      .sort((a, b) => Number(b) - Number(a))
      .map(month => ({ month, posts: groupedPosts.get(year)!.get(month)! }))
  }));
---

<BaseLayout title="归档" description="按时间浏览全部博客、周刊和随笔，也可以直接搜索。">
  <main class="container editorial-page archive-page">
    <header class="page-head">
      <div class="weekly-heading">
        <h1>档案馆</h1>
        <span class="weekly-count">共 {posts.length} 篇</span>
      </div>
    </header>

    <section class="section archive-search-section">
      <ArchiveSearch />
    </section>

    <div id="archive-list" class="archive-groups">
      {archiveYears.map(({ year, months }) => (
        <section class="archive-year">
          <header class="archive-year-heading">
            <h2>{year}</h2>
          </header>

          {months.map(({ month, posts: monthPosts }) => (
            <section class="archive-month">
              <h3 class="archive-month-title">{month} 月</h3>
              <EditorialPostList
                kind="archive"
                posts={monthPosts.map(post => ({
                  href: getPostHref(post),
                  title: post.data.title,
                  description: post.data.description,
                  date: post.data.pubDate,
                  tags: post.data.tags,
                  postKind: getPostKind(post)
                }))}
              />
            </section>
          ))}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
