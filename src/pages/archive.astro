---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ArchiveSearch from '../components/ArchiveSearch.astro';
import { getPublishedPosts, getPostHref, type AnyPost } from '../lib/posts';

const posts = await getPublishedPosts();

const groupedPosts = posts.reduce((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');

  if (!acc.has(year)) acc.set(year, new Map<string, AnyPost[]>());
  const yearMap = acc.get(year)!;
  if (!yearMap.has(month)) yearMap.set(month, []);
  yearMap.get(month)!.push(post);

  return acc;
}, new Map<string, Map<string, AnyPost[]>>());

const years = [...groupedPosts.keys()].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="归档" description="按时间浏览全部博客、周刊和随笔，也可以直接搜索。">
  <main class="container">
    <section class="hero">
      <h1>归档</h1>
      <p>按时间查看所有内容，也可以直接搜索。</p>
    </section>

    <section class="section archive-search-section">
      <ArchiveSearch />
    </section>

    <div id="archive-list">
      {years.map(year => (
        <section class="archive-year">
          <h2 class="section-title">{year}</h2>

          {[...groupedPosts.get(year)!.keys()].sort((a, b) => Number(b) - Number(a)).map(month => (
            <section class="archive-month">
              <h3 class="archive-month-title">{month} 月</h3>
              <div class="card-grid">
                {groupedPosts.get(year)!.get(month)!.map(post => (
                  <PostCard
                    href={getPostHref(post)}
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.pubDate}
                    cover={post.data.cover}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          ))}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
