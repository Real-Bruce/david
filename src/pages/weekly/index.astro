---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeeklyCard from '../../components/WeeklyCard.astro';
import IssueWall from '../../components/IssueWall.astro';
import { getWeeklyInsights } from '../../lib/weekly';
import { withBase } from '../../lib/base';
import { getCollection } from 'astro:content';

const posts = (await getCollection('weekly', ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);

const latest = posts.slice(0, 6);
const rest = posts.slice(6);
---

<BaseLayout title="周刊" description="每周收集的有趣网站、工具和阅读材料。">
  <main class="container weekly-page">
    <header class="page-head">
      <div class="page-head-row">
        <h1>周刊</h1>
        <span class="page-head-meta">共 {posts.length} 期 · 每周更新</span>
      </div>
      <p class="page-head-desc">每周收集一次好玩的网站、工具、文章和灵感。</p>
    </header>

    <div class="insight-grid">
      {latest.map(post => (
        <WeeklyCard
          href={withBase(`/weekly/${post.id}/`)}
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
          issue={post.data.issue}
          insights={getWeeklyInsights(post)}
        />
      ))}
    </div>

    {rest.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="section-title">往期</h2>
          <span class="section-more">{rest.length} 期</span>
        </div>
        <IssueWall posts={rest} />
      </section>
    )}
  </main>
</BaseLayout>