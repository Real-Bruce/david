---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('weekly', ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);
---

<BaseLayout title="周刊" description="每周收集的有趣网站、工具和阅读材料。">
  <main class="container weekly-page">
    <section class="weekly-hero">
      <h1>周刊</h1>
      <p>每周收集一次好玩的网站、工具、文章和灵感。</p>
    </section>

    <section class="weekly-feed">
      <div class="card-grid">
        {posts.map(post => (
          <PostCard
            href={`/weekly/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            cover={post.data.cover}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
