---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const posts = await getCollection('weekly', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ReadingProgress />
  <main class="article weekly-article">
    <header class="article-header article-header-weekly">
      <div class="meta">
        <span class="kind kind-weekly">周刊</span>
        <span class="weekly-issue">Vol.{post.data.issue}</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1>{post.data.title}</h1>

      {post.data.description && (
        <p class="weekly-desc">{post.data.description}</p>
      )}

      {post.data.tags.length > 0 && (
        <div class="article-meta" aria-label="文章标签">
          {post.data.tags.map(tag => <a class="tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {post.data.links.length > 0 && (
      <section class="section">
        <h2 class="section-title">本期推荐</h2>
        <div class="link-list">
          {post.data.links.map(item => (
            <a class="link-card" href={item.url} target="_blank" rel="noopener noreferrer">
              <span class="link-card-header">
                <span class="link-card-title">{item.title}</span>
                <span class="link-card-domain">{new URL(item.url).hostname}</span>
              </span>
              {item.note && <span class="link-card-desc">{item.note}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>