---
import { getWeeklyArchiveCategories } from '../../../lib/weekly-archives';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return getWeeklyArchiveCategories().map(category => ({
    params: { category: category.id },
    props: { latestYear: category.years[0]?.year }
  }));
}

const { latestYear } = Astro.props;
const target = latestYear
  ? withBase(`/weekly/${Astro.params.category}/${latestYear}/`)
  : withBase('/weekly/');

return Astro.redirect(target);
---
