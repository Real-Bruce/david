---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Pagination from '../../../components/Pagination.astro';
import { getWeeklyDigest } from '../../../lib/weekly';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/base';

export async function getStaticPaths() {
  const posts = (await getCollection('weekly', ({ data }) => !data.draft)).sort((a, b) => b.data.issue - a.data.issue);
  const pageSize = 10;
  return Array.from({ length: Math.ceil(posts.length / pageSize) - 1 }, (_, index) => ({ params: { page: String(index + 2) }, props: { posts, currentPage: index + 2 } }));
}
const { posts, currentPage } = Astro.props;
const pageSize = 10;
const pagePosts = posts.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const dateText = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<BaseLayout title={`周刊 · 第 ${currentPage} 页`} description="每周收集的有趣网站、工具和阅读材料。">
  <main class="container weekly-page">
    <header class="page-head"><div class="section-head"><span class="page-head-icon tint-weekly"><Icon name="weekly" size={38} /></span><div class="section-head-text"><div class="weekly-heading"><span class="weekly-count">共 {posts.length} 期</span></div><p class="page-head-desc">每周的新发现，留给好奇心一点时间。</p></div></div></header>
    <section class="weekly-list" aria-label="周刊列表"><ol class="weekly-entries">{pagePosts.map(post => <li><a class="weekly-entry" href={withBase(`/weekly/${post.id}/`)}><div class="weekly-entry-meta"><span>第 {post.data.issue} 期</span><time datetime={post.data.pubDate.toISOString()}>{dateText(post.data.pubDate)}</time></div><h3>{getWeeklyDigest(post).title}</h3></a></li>)}</ol></section>
    <Pagination currentPage={currentPage} totalPages={Math.ceil(posts.length / pageSize)} basePath={withBase('/weekly')} />
  </main>
</BaseLayout>
