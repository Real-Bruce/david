---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyCard from '../components/WeeklyCard.astro';
import { getCollection } from 'astro:content';

const weeklyPosts = (await getCollection('weekly', ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const notePosts = await getCollection('notes', ({ data }) => !data.draft);

const latest = weeklyPosts.slice(0, 5);
---

<BaseLayout description="周刊负责有趣，博客负责深度，随笔负责随手记下的人间时刻。">
  <main>
    <section class="hero">
      <div class="container">
        <p class="hero-kicker">个人品味 · 每周更新</p>
        <h1>Easy to say. Do it. Write it down.</h1>
        <p>周刊负责有趣，博客负责深度，随笔负责随手记下的人间时刻。</p>
        <p class="hero-stats">周刊 {weeklyPosts.length} 期 · 长文 {blogPosts.length} 篇 · 随笔 {notePosts.length} 条</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">最新周刊</h2>
          <a class="section-more" href="/weekly/">全部 {weeklyPosts.length} 期 →</a>
        </div>
        <div class="weekly-grid">
          {latest.map((post, index) => (
            <WeeklyCard
              href={`/weekly/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              issue={post.data.issue}
              tags={post.data.tags}
              featured={index === 0}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section home-more">
      <div class="container">
        <div class="home-more-row">
          <a class="home-more-item" href="/blog/">
            <span class="home-more-title">去读长文</span>
            <p class="home-more-sub">{blogPosts.length} 篇完整思考</p>
          </a>
          <a class="home-more-item" href="/notes/">
            <span class="home-more-title">翻翻随笔</span>
            <p class="home-more-sub">{notePosts.length} 条碎片记录</p>
          </a>
          <a class="home-more-item" href="/archive/">
            <span class="home-more-title">完整归档</span>
            <p class="home-more-sub">按时间检索全部内容</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>