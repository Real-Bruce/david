---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyCard from '../components/WeeklyCard.astro';
import { getWeeklyInsights } from '../lib/weekly';
import { withBase } from '../lib/base';
import { getCollection } from 'astro:content';

const weeklyPosts = (await getCollection('weekly', ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const notePosts = await getCollection('notes', ({ data }) => !data.draft);

const latest = weeklyPosts.slice(0, 5);
---

<BaseLayout description="记录每周发现、长期思考与随手灵感。">
  <main>
    <section class="hero">
      <div class="container">
        <h1>降低期待，积极行动</h1>
        <p>记录每周发现、长期思考与随手灵感。</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">最新周刊</h2>
          <a class="section-more" href={withBase('/weekly/')}>全部 {weeklyPosts.length} 期 →</a>
        </div>
        <div class="insight-grid">
          {latest.map((post, index) => (
            <WeeklyCard
              href={withBase(`/weekly/${post.id}/`)}
              title={post.data.title}
              description={post.data.description}
              issue={post.data.issue}
              insights={getWeeklyInsights(post)}
              featured={index === 0}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section home-more">
      <div class="container">
        <div class="home-more-row">
          <a class="home-more-item" href={withBase('/blog/')}>
            <span class="home-more-title">去读长文</span>
            <p class="home-more-sub">{blogPosts.length} 篇完整思考</p>
          </a>
          <a class="home-more-item" href={withBase('/notes/')}>
            <span class="home-more-title">翻翻随笔</span>
            <p class="home-more-sub">{notePosts.length} 条碎片记录</p>
          </a>
          <a class="home-more-item" href={withBase('/archive/')}>
            <span class="home-more-title">完整归档</span>
            <p class="home-more-sub">按时间检索全部内容</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>