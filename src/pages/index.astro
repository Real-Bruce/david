---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, getPostHref, getPostKind, getPostKindLabel } from '../lib/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
---

<BaseLayout title="首页" description="记录周刊、长文与随笔的个人博客。">
  <main>
    <section class="hero">
      <div class="container">
        <h1>把看到的好东西，写成长久的记录。</h1>
        <p>这里收录我的周刊、完整博客和随时写下的随笔。内容用 Markdown 写作，网站由 GitHub 自动构建发布。</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">最新内容</h2>
          <a class="section-more" href="/archive/">查看全部归档</a>
        </div>
        <div class="grid">
          {latest.map(post => (
            <PostCard
              href={getPostHref(post)}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              tags={post.data.tags}
              kind={getPostKindLabel(getPostKind(post))}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
