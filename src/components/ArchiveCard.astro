---
import type { WeeklyArchiveSummary } from '../lib/weekly-archives';
import { withBase } from '../lib/base';

interface Props {
  summary: WeeklyArchiveSummary;
}

const { summary } = Astro.props;
---

<a class="insight-card archive-card" href={withBase(`/weekly/archives/${summary.id}/`)}>
  <div class="ic-head">
    <span class="ic-no">{summary.title}</span>
    <span class="ic-meta">推荐整合</span>
  </div>

  <div class="ic-body">
    <ul class="ic-links">
      {summary.links.map(link => <li title={link}><span>{link}</span></li>)}
    </ul>
  </div>

  <span class="ic-more">浏览全部 {summary.total} 条推荐 →</span>
</a>
