---
---

<div class="archive-search">
  <input
    id="archive-search-input"
    class="search-input"
    type="search"
    placeholder="搜索标题、内容或标签"
    autocomplete="off"
  />
  <div id="archive-search-results" class="search-results" aria-live="polite"></div>
</div>

<script is:inline>
  const input = document.getElementById('archive-search-input');
  const resultsBox = document.getElementById('archive-search-results');
  const archiveList = document.getElementById('archive-list');
  let pagefind = null;

  async function ensureIndex() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options?.();
      return pagefind;
    } catch (error) {
      resultsBox.innerHTML = '<p class="empty">搜索索引暂不可用，请先执行完整构建。</p>';
      return null;
    }
  }

  async function search(value) {
    if (!value.trim()) {
      resultsBox.innerHTML = '';
      if (archiveList) archiveList.hidden = false;
      return;
    }

    if (archiveList) archiveList.hidden = true;

    const index = await ensureIndex();
    if (!index) return;

    const results = await index.search(value);
    if (!results?.results?.length) {
      resultsBox.innerHTML = '<p class="empty">没有找到相关内容。</p>';
      return;
    }

    const items = await Promise.all(results.results.slice(0, 24).map(result => result.data()));
    resultsBox.innerHTML = items.map(item => `
      <article class="search-result">
        <h3><a href="${item.url}">${item.meta?.title || item.url}</a></h3>
        <p class="empty">${item.excerpt}</p>
      </article>
    `).join('');
  }

  let timer;
  input.addEventListener('input', event => {
    clearTimeout(timer);
    timer = setTimeout(() => search(event.target.value), 180);
  });
</script>
