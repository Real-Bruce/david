---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  kind: 'weekly' | 'blog' | 'notes';
  mood?: string;
  location?: string;
}

const {
  href,
  title,
  description,
  date,
  tags = [],
  kind,
  mood,
  location
} = Astro.props;

const dateText = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const kindLabel = kind === 'weekly' ? '周刊' : kind === 'blog' ? '博客' : '随笔';
---

<article class="entry" data-kind={kind}>
  <a class="entry-link" href={href}>
    <div class="entry-meta">
      <time datetime={date.toISOString()}>{dateText}</time>
      <span class={`kind kind-${kind}`}>{kindLabel}</span>
      {mood && <span class="entry-mood" aria-label="心情">{mood}</span>}
      {location && <span class="entry-loc" aria-label="地点">{location}</span>}
    </div>
    <h3 class="entry-title">{title}</h3>
    <p class="entry-desc">{description}</p>
  </a>

  {tags.length > 0 && (
    <div class="tags">
      {tags.map(tag => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
    </div>
  )}
</article>