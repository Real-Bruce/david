---
interface Props {
  name: 'archive' | 'user' | 'menu';
  size?: number;
}

const { name, size = 20 } = Astro.props;

const icons = {
  archive: '<rect x="3" y="4" width="18" height="4" rx="1.8"></rect><path d="M5 10h14v7a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"></path>',
  user: '<circle cx="12" cy="8" r="4.2"></circle><path d="M12 14.2c-3.9 0-6.6 2.5-6.6 5.4 0 .9.7 1.6 1.6 1.6h10c.9 0 1.6-.7 1.6-1.6 0-2.9-2.7-5.4-6.6-5.4z"></path>',
  menu: '<rect x="4" y="5.5" width="16" height="3" rx="1.5"></rect><rect x="4" y="10.5" width="16" height="3" rx="1.5"></rect><rect x="4" y="15.5" width="16" height="3" rx="1.5"></rect>'
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  set:html={icons[name]}
/>