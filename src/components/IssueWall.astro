---
import type { CollectionEntry } from 'astro:content';
import { getWeeklyInsights } from '../lib/weekly';

interface Props {
  posts: CollectionEntry<'weekly'>[];
}

const { posts } = Astro.props;

type WeeklyPosts = CollectionEntry<'weekly'>[];

const groups = new Map<string, WeeklyPosts>();
for (const post of posts) {
  const year = String(post.data.pubDate.getFullYear());
  const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');
  const key = `${year}-${month}`;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(post);
}

const keys = [...groups.keys()].sort((a, b) => b.localeCompare(a));
---

{keys.map(key => {
  const [year, month] = key.split('-');
  return (
    <section class="wall-group">
      <p class="wall-group-label">
        <span class="wall-year">{year}</span>
        <span>· {month} 月</span>
      </p>

      <div class="issue-wall">
        {groups.get(key)!.map(post => {
          const insights = getWeeklyInsights(post);
          const samples = insights.links.slice(0, 2);

          return (
            <a class="wall-tile" href={`/weekly/${post.id}/`} title={post.data.title}>
              <span class="wall-tile-head">
                <span class="wall-no">Vol.{post.data.issue}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
              </span>

              <ul class="wall-links">
                {samples.length > 0
                  ? samples.map(link => <li>{link}</li>)
                  : <li class="wall-fallback">{post.data.description}</li>}
              </ul>

              <span class="wall-count">
                {insights.total > 0 ? `共 ${insights.total} 条推荐` : '查看本期'}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  );
})}