---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const href = (page: number) => page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页导航">
    {currentPage > 1 ? <a href={href(currentPage - 1)} aria-label="上一页">上一页</a> : <span aria-hidden="true">上一页</span>}
    <span class="pagination-current">第 {currentPage} / {totalPages} 页</span>
    {currentPage < totalPages ? <a href={href(currentPage + 1)} aria-label="下一页">下一页</a> : <span aria-hidden="true">下一页</span>}
  </nav>
)}
