---
interface Props {
  previous?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="article-navigation" aria-label="文章导航">
    {previous ? <a href={previous.href}><span>上一篇</span><strong>{previous.title}</strong></a> : <span />}
    {next ? <a class="article-navigation-next" href={next.href}><span>下一篇</span><strong>{next.title}</strong></a> : <span />}
  </nav>
)}
