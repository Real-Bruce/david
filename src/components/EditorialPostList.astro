---
import Icon from './Icon.astro';
import { withBase } from '../lib/base';

interface EditorialPost {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  issue?: number;
  mood?: string;
  location?: string;
  postKind?: 'weekly' | 'blog' | 'notes';
}

interface Props {
  kind: 'blog' | 'notes' | 'archive';
  posts: EditorialPost[];
}

const { kind, posts } = Astro.props;
const isNotes = kind === 'notes';
const typeLabels = { weekly: 'Weekly', blog: 'Blog', notes: 'Notes' };
const dateText = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

{posts.length > 0 ? (
  <section class:list={['editorial-list', `editorial-${kind}`]}>
    <ol class="editorial-entries">
      {posts.map(post => (
        <li>
          <article
            class:list={[
              'editorial-entry',
              kind === 'archive' && post.postKind && `editorial-entry-${post.postKind}`
            ]}
            data-kind={post.postKind}
            data-search={`${post.title} ${post.description} ${post.tags.join(' ')}`}
          >
            <div class="editorial-entry-meta">
              <time datetime={post.date.toISOString()}>{kind === 'archive' ? dateText(post.date).slice(5) : dateText(post.date)}</time>
              {isNotes && post.mood && (
                <span class="entry-mood-item">
                  <Icon name="mood" size={14} />
                  <span>{post.mood}</span>
                </span>
              )}
              {isNotes && post.location && (
                <span class="entry-location">
                  <Icon name="location" size={14} />
                  <span>{post.location}</span>
                </span>
              )}
            </div>
            {kind === 'archive' && post.postKind && (
              <span class="editorial-entry-type" aria-label={post.postKind === 'weekly' && post.issue ? `Weekly · Vol.${post.issue}` : typeLabels[post.postKind]} title={post.postKind === 'weekly' && post.issue ? `Weekly · Vol.${post.issue}` : typeLabels[post.postKind]}>
                <Icon name={post.postKind} size={14} />
                {post.postKind === 'weekly' && post.issue ? `Vol.${post.issue}` : null}
              </span>
            )}
            <a class="editorial-entry-content" href={post.href}>
              <h3>{post.title}</h3>
              {kind !== 'archive' || post.postKind === 'blog' ? <p>{post.description}</p> : null}
            </a>
            {kind !== 'archive' && post.tags.length > 0 && (
              <div class="editorial-entry-tags" aria-label="文章标签">
                {post.tags.map(tag => <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>
) : (
  <p class="editorial-empty">这里还没有内容，第一篇很快就会出现。</p>
)}
