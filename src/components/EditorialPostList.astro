---
import { withBase } from '../lib/base';
import Icon from './Icon.astro';

interface EditorialPost {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  mood?: string;
  location?: string;
  postKind?: 'weekly' | 'blog' | 'notes';
}

interface Props {
  kind: 'blog' | 'notes' | 'archive';
  posts: EditorialPost[];
}

const { kind, posts } = Astro.props;
const isNotes = kind === 'notes';
const typeLabels = { weekly: '周刊', blog: '博客', notes: '随笔' };
const dateText = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

{posts.length > 0 ? (
  <section class:list={['editorial-list', `editorial-${kind}`]}>
    <ol class="editorial-entries">
      {posts.map(post => (
        <li>
          <article
            class:list={[
              'editorial-entry',
              kind === 'archive' && post.postKind && `editorial-entry-${post.postKind}`
            ]}
          >
            <div class="editorial-entry-meta">
              <time datetime={post.date.toISOString()}>{dateText(post.date)}</time>
              {kind === 'archive' && post.postKind && (
                <span class="editorial-entry-type">{typeLabels[post.postKind]}</span>
              )}
              {isNotes && post.mood && (
                <span class="entry-mood-item">
                  <Icon name="mood" size={14} />
                  <span>{post.mood}</span>
                </span>
              )}
              {isNotes && post.location && (
                <span class="entry-location">
                  <Icon name="location" size={14} />
                  <span>{post.location}</span>
                </span>
              )}
            </div>
            <a class="editorial-entry-content" href={post.href}>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </a>
            {post.tags.length > 0 && (
              <div class="editorial-entry-tags" aria-label="文章标签">
                {post.tags.map(tag => <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>
) : (
  <p class="editorial-empty">这里还没有内容，第一篇很快就会出现。</p>
)}
