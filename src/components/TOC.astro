---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

{items.length > 1 && (
  <nav class="toc" aria-label="文章目录">
    <p class="toc-title">目录</p>
    <ol class="toc-list">
      {items.map(heading => (
        <li class:list={['toc-item', { sub: heading.depth === 3 }]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}