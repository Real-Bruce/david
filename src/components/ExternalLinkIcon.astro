---
interface Props {
  size?: number | string;
}
const { size = 16 } = Astro.props;
const numericSize = typeof size === 'number' ? size : Number(size);
---
<svg
  class="external-link-icon"
  xmlns="http://www.w3.org/2000/svg"
  width={numericSize}
  height={numericSize}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M10.5 13.5a3.5 3.5 0 0 1 0-5l4-4a3.5 3.5 0 0 1 5 0 3.5 3.5 0 0 1 0 5l-1.5 1.5" />
  <path d="M13.5 10.5a3.5 3.5 0 0 1 0 5l-4 4a3.5 3.5 0 0 1-5 0 3.5 3.5 0 0 1 0-5l1.5-1.5" />
</svg>
