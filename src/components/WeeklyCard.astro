---
import type { WeeklyInsights } from '../lib/weekly';

interface Props {
  href: string;
  title: string;
  description: string;
  issue: number;
  insights: WeeklyInsights;
  featured?: boolean;
}

const {
  href,
  title,
  description,
  issue,
  insights,
  featured = false
} = Astro.props;

const sampleLinks = insights.links.slice(0, featured ? 5 : 3);
const hasLinks = sampleLinks.length > 0;
const statIcon = (name: string) => {
  const match = name.match(/\p{Extended_Pictographic}/u);
  return match?.[0] ?? '•';
};
---

<a class:list={['insight-card', { featured }]} href={href} title={title}>
  <div class="ic-head">
    <span class="ic-no">Vol.{issue}</span>
  </div>

  <div class="ic-body">
    {insights.stats.length > 0 && (
      <div class="ic-stats">
        {insights.stats.map(stat => (
          <span class="ic-stat" title={stat.name} aria-label={`${stat.name} ${stat.count}`}>
            <span aria-hidden="true">{statIcon(stat.name)}</span>
            <span aria-hidden="true">{stat.count}</span>
          </span>
        ))}
      </div>
    )}

    {hasLinks ? (
      <ul class="ic-links">
        {sampleLinks.map(link => <li title={link}><span>{link}</span></li>)}
      </ul>
    ) : (
      <p class="ic-fallback">{description}</p>
    )}
  </div>

  {insights.total > 0 && (
    <p class="ic-more">共 {insights.total} 条推荐 →</p>
  )}
</a>