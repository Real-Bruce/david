---
import type { WeeklyInsights } from '../lib/weekly';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  issue: number;
  insights: WeeklyInsights;
  featured?: boolean;
}

const {
  href,
  title,
  description,
  date,
  issue,
  insights,
  featured = false
} = Astro.props;

const dateText = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const sampleLinks = insights.links.slice(0, featured ? 5 : 3);
const hasLinks = sampleLinks.length > 0;
---

<a class:list={['insight-card', { featured }]} href={href} title={title}>
  <div class="ic-head">
    <span class="ic-no">Vol.{issue}</span>
    <time datetime={date.toISOString()}>{dateText}</time>
  </div>

  {insights.stats.length > 0 && (
    <div class="ic-stats">
      {insights.stats.map(stat => (
        <span class="ic-stat">{stat.name} {stat.count}</span>
      ))}
    </div>
  )}

  {hasLinks ? (
    <ul class="ic-links">
      {sampleLinks.map(link => <li>{link}</li>)}
    </ul>
  ) : (
    <p class="ic-fallback">{description}</p>
  )}

  {insights.total > 0 && (
    <p class="ic-more">共 {insights.total} 条推荐 →</p>
  )}
</a>