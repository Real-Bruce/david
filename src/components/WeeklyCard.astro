---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  cover: string;
  issue: number;
}

const { href, title, description, date, cover, issue } = Astro.props;
const dateText = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<a class="weekly-card" href={href}>
  <div class="weekly-cover">
    <img src={cover} alt={title} width="640" height="384" loading="lazy" decoding="async" />
  </div>
  <div class="weekly-card-meta">
    <span class="weekly-title">第 {issue} 期 · {title}</span>
    <time datetime={date.toISOString()}>{dateText}</time>
  </div>
  <p class="weekly-desc">{description}</p>
</a>
