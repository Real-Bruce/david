---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  issue: number;
  tags?: string[];
  featured?: boolean;
}

const {
  href,
  title,
  description,
  date,
  issue,
  tags = [],
  featured = false
} = Astro.props;

const dateText = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<a class:list={['weekly-card', { featured }]} href={href}>
  <div class="weekly-card-top">
    <span class="weekly-no">№ {issue}</span>
    <time datetime={date.toISOString()}>{dateText}</time>
  </div>

  <h3 class="weekly-title">{title}</h3>
  <p class="weekly-desc">{description}</p>

  {tags.length > 0 && (
    <div class="tags">
      {tags.map(tag => <span class="tag">#{tag}</span>)}
    </div>
  )}
</a>