---
import { siteConfig } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>© {year} {siteConfig.author.name} · {siteConfig.description}</div>
    <div>
      <a href="/rss.xml">RSS</a> · <a href={siteConfig.social.github}>GitHub</a> · <a href={siteConfig.social.email}>Email</a>
    </div>
  </div>
</footer>
