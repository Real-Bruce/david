<button id="back-to-top" class="back-to-top" type="button" aria-label="返回顶部">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 20V5"></path>
    <path d="M5 12l7-7 7 7"></path>
  </svg>
</button>

<script is:inline>
  const button = document.getElementById('back-to-top');
  let lastY = window.scrollY;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const movingDown = y > lastY + 4;
    const movingUp = y < lastY - 4;

    if (movingDown && y > 320) {
      button.classList.add('show');
    } else if (movingUp || y < 240) {
      button.classList.remove('show');
    }

    lastY = y;
  }, { passive: true });

  button.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
