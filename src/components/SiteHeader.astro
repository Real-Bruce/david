---
import { siteConfig } from '../site.config';
import { withBase } from '../lib/base';
import Icon from './Icon.astro';

/** 统一补齐 base 前缀与结尾斜杠，否则 /david 子路径部署下当前页永远匹配不上。 */
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = withTrailingSlash(Astro.url.pathname);
const homePath = withTrailingSlash(withBase('/'));
const normalize = (href: string) => withTrailingSlash(withBase(href));
const isActive = (href: string) =>
  href === '/' ? currentPath === homePath : currentPath.startsWith(normalize(href));
const currentAttr = (href: string) => (isActive(href) ? 'page' : undefined);

const primaryNav = [
  { href: '/weekly/', label: '周刊' },
  { href: '/blog/', label: '博客' },
  { href: '/notes/', label: '随笔' }
];
const primaryActive = primaryNav.some(link => isActive(link.href));

const utilityNav = [
  { href: '/archive/', label: '归档', icon: 'archive' },
  { href: '/about/', label: '关于', icon: 'user' }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} title="返回首页">
      <span class="brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
          <rect width="32" height="32" rx="10" fill="var(--fg)" />
          <path fill="var(--bg)" fill-rule="evenodd" d="M10.5 9.5 H15 A6.5 6.5 0 0 1 15 22.5 H10.5 Z M13.5 12.5 H15 A3.5 3.5 0 0 1 15 19.5 H13.5 Z" />
        </svg>
      </span>
      <span class="brand-title">{siteConfig.title}</span>
      <span class="brand-title-short">{siteConfig.shortTitle}</span>
    </a>

    <div class="header-actions">
      <nav class="nav nav-text" aria-label="主导航">
        {primaryNav.map(link => (
          <a
            href={withBase(link.href)}
            class:list={[{ active: isActive(link.href) }]}
            aria-current={currentAttr(link.href)}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <nav class="nav-icons" aria-label="功能导航">
        {utilityNav.map(link => (
          <a
            href={withBase(link.href)}
            class:list={['icon-button', { active: isActive(link.href) }]}
            aria-current={currentAttr(link.href)}
            aria-label={link.label}
            title={link.label}
          >
            <Icon name={link.icon as 'archive' | 'user'} />
          </a>
        ))}
      </nav>

      <nav class="mobile-nav" aria-label="移动端主导航">
        <button
          type="button"
          class:list={['icon-button', 'mobile-nav-trigger', { active: primaryActive }]}
          aria-label="打开主导航"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
        >
          <span class="mobile-nav-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <div class="mobile-nav-backdrop" aria-hidden="true"></div>
        <div class="mobile-nav-list" id="mobile-nav-panel">
          {primaryNav.map(link => (
            <a
              href={withBase(link.href)}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={currentAttr(link.href)}
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // 移动端浮层菜单：按钮切换、遮罩/链接/Esc 收起
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
  const trigger = mobileNav?.querySelector<HTMLButtonElement>('.mobile-nav-trigger');

  if (mobileNav && trigger) {
    const setOpen = (open: boolean) => {
      mobileNav.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? '关闭主导航' : '打开主导航');
    };

    trigger.addEventListener('click', () => {
      setOpen(!mobileNav.classList.contains('is-open'));
    });

    mobileNav.querySelector('.mobile-nav-backdrop')?.addEventListener('click', () => setOpen(false));
    mobileNav.querySelectorAll('.mobile-nav-list a').forEach(link => {
      link.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>