---
const links = [
  { href: '/', label: '首页' },
  { href: '/weekly/', label: '周刊' },
  { href: '/blog/', label: '博客' },
  { href: '/notes/', label: '随笔' },
  { href: '/archive/', label: '归档' },
  { href: '/search/', label: '搜索' },
  { href: '/about/', label: '关于' }
];
const currentPath = Astro.url.pathname.replace(/\/$/, '/') || '/';
const normalize = (href: string) => href === '/' ? '/' : href.replace(/\/$/, '/') + '/';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(normalize(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">B</span>
      <span>Personal Blog</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {links.map(link => (
        <a href={link.href} class:list={[{ active: isActive(link.href) }]}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
