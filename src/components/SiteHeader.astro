---
import { siteConfig } from '../site.config';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '/') || '/';
const normalize = (href: string) => href === '/' ? '/' : href.replace(/\/$/, '/') + '/';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(normalize(href));

const primaryNav = [
  { href: '/weekly/', label: '周刊' },
  { href: '/blog/', label: '博客' },
  { href: '/notes/', label: '随笔' }
];

const utilityNav = [
  { href: '/archive/', label: '归档', icon: 'archive' },
  { href: '/about/', label: '关于', icon: 'user' }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" title="返回首页">
      <span class="brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
          <rect width="32" height="32" rx="10" fill="var(--fg)" />
          <path fill="var(--bg)" fill-rule="evenodd" d="M10.5 9.5 H15 A6.5 6.5 0 0 1 15 22.5 H10.5 Z M13.5 12.5 H15 A3.5 3.5 0 0 1 15 19.5 H13.5 Z" />
        </svg>
      </span>
      <span>{siteConfig.title}</span>
    </a>

    <div class="header-actions">
      <nav class="nav nav-text" aria-label="主导航">
        {primaryNav.map(link => (
          <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
            {link.label}
          </a>
        ))}
      </nav>

      <nav class="nav-icons" aria-label="功能导航">
        {utilityNav.map(link => (
          <a
            href={link.href}
            class:list={['icon-button', { active: isActive(link.href) }]}
            aria-label={link.label}
            title={link.label}
          >
            <Icon name={link.icon as 'archive' | 'user'} />
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
